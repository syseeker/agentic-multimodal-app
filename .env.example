# ─────────────────────────────────────────────────────────────────────────────
# SINGLE SOURCE OF TRUTH for shared secrets/config across ALL NVIDIA components.
# Copy to `.env`, fill in, then `deploy/propagate_env.sh <component>/deploy/.env`
# distributes the shared keys into each component's own .env (AI-Q, RAG-BP, VSS…).
# `.env` is git-ignored. Never commit real keys.
# ─────────────────────────────────────────────────────────────────────────────

# Shared credentials (needed by multiple components)
NVIDIA_API_KEY=        # hosted NIMs (dev) — air-gapped prod self-hosts instead
NGC_API_KEY=           # NGC image/model pulls
HF_TOKEN=              # gated Hugging Face checkpoints (e.g. MERaLiON)

# Harmonized stack identity (keeps us isolated from any other AI-Q/VSS on the host)
COMPOSE_PROJECT_NAME=amms

# Host ports for the harmonized stack (avoid 8000/3000/5432 if already taken)
AIQ_PORT=8100          # AI-Q deep-research sub-agent (:8100 -> container 8000)

# Phase 5 — VSS runs on the SAME machine as the GPU. There is no remote-GPU option:
# the LVS video pipeline assumes single-machine (VIOS hands rtvi-vlm a local file path).
# See .claude/context/implementation-learnings.md → "CPU-to-Remote-GPU ... ABANDONED".

# ── Model selection (optional — safe to leave blank, defaults shown) ───────────
# These are configuration, not secrets. They live here for convenience alongside
# the API keys that each model needs. Override per-run with the matching CLI flag.

# Phase 4 — ASR model for Parakeet (process_audio.py --model / ASR_MODEL)
# ASR_MODEL=ai-parakeet-1_1b-rnnt-multilingual-asr   # default; covers EN/ZH/MS/VI/FIL
# ASR_MODEL=ai-whisper-large-v3                       # 99 languages (unknown dialect)
# ASR_MODEL=ai-nemotron-asr-streaming                 # English + speaker diarization

# Phase 4 — MERaLiON paralinguistics model (process_audio.py, MERALION_MODEL)
# MERALION_MODEL=MERaLiON/MERaLiON-3-10B             # default; emotion/stress/lang-id

# Data sim — Magpie TTS model (generate_audio_samples.py --magpie-model / MAGPIE_MODEL)
# MAGPIE_MODEL=ai-magpie-tts-multilingual             # default

# Data sim — Hokkien TTS model (generate_audio_samples.py --hokkien-model / HOKKIEN_MODEL)
# HOKKIEN_MODEL=MERaLiON/MERaLiON-OmniVoice-Hokkien-TTS   # default
